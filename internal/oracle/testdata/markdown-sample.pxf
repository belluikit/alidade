# The Markdown layer's documents edges, hand-labelled (#2).
#
# A documents edge is INFERRED: a code span in a section names exactly one
# node, and nothing but a reader can say whether the prose meant that
# declaration. These 58 were drawn from the 1,140 documents edges of nine
# public repositories (alidade, caliper, chameleon, goasm, protocompile,
# protoregistry, protovalidate, protowire-go, pylib) on 2026-10-14, by
# TestDrawSamples: allotted in proportion to each repository's count and
# taken in order of the SHA-256 of "repo|from|to". Each was judged by
# reading the sentence around the mention and the declaration it names.
# 54 of the 58 are right: 0.931.
#
# label is right when the mention names that declaration, wrong when it
# names something else that happens to share the name. A mention of an
# MCP tool (`neighbors`) is judged wrong for the Go function of that name
# behind it. TestOracleGoCalls (scripts/oracle.sh) re-reads the sample for
# every repository checked out at the commit it was labelled at: a right
# edge gone is a regression, a wrong edge gone is a fix.
#
# This sample replaces one of the same size drawn on 2026-10-08 from 16
# repositories, most of them private, where 53 of 58 were right (0.914).

repo {
  name = "alidade"
  commit = "5b8255e026cb3ef8bae48addbe022f28ebee0a2e"
  edge {
    from = "md://docs/usage.md#using-alidade.using-alidade-instead-of-grep"
    to = "go://github.com/trendvidia/alidade/internal/mcp#neighbors"
    mention = "neighbors"
    label = wrong
    why = "the MCP tool of that name; this is the traversal helper behind it"
  }
  edge {
    from = "md://CONTRIBUTING.md#contributing-to-alidade.building"
    to = "go://github.com/trendvidia/alidade/internal/python"
    mention = "python"
    label = wrong
    why = "a build tag, not the package"
  }
  edge {
    from = "md://CHANGELOG.md#changelog.v0-7-0-2026-10-07"
    to = "go://github.com/trendvidia/alidade/internal/adapter/ts#Extensions"
    mention = "ts.Extensions"
    label = right
  }
  edge {
    from = "md://docs/usage.md#using-alidade.the-tools"
    to = "go://github.com/trendvidia/alidade/internal/mcp#neighbors"
    mention = "neighbors"
    label = wrong
    why = "the MCP tool of that name; this is the traversal helper behind it"
  }
  edge {
    from = "md://docs/adr/008-python-engine.md#adr-008-python-cpython-embedded-jedi-as-the-engine-for-calls.decision"
    to = "py://internal/python/resolve.py"
    mention = "resolve.py"
    label = right
  }
}

