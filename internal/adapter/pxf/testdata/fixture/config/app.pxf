@type example.v1.Config

# The fixture's main document: nested blocks, every value kind, a list of
# blocks with ids, a scalar list, a map, a keyed block, references of
# three kinds, and a value that must never reach the graph.
server {
  host = "localhost"
  port = 8080
  ratio = 0.5
  debug = true
  mode = FAST
  started = 2026-01-01T00:00:00Z
  timeout = 30s
  raw = b"AAEC"
  nothing = null
  tags = ["a", "b"]
  # A reference to a field of this document, a context reference, and
  # one that resolves to nothing.
  url = "http://${server.host}:${server.port}/${env}"
  fallback = "${missing.path}"
  password = "hunter2"
}

regions = [
  { id = "us-east-1"  weight = 1 }
  { name = "eu-west"  weight = 2 }
  { weight = 3 }
]

sources = {
  "default": { kind = "fs" }
  "env":     { kind = "env" }
}

"us-east-1" {
  capacity = 10
}
