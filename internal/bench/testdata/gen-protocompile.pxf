# Questions over protocompile drawn by rule, not picked (#284): bench.Generate over the
# type checker's static calls (internal/oracle), without tests, at the commit
# below. Strata: unique (callers of a name no other declaration shares),
# shared (callers of a method name five or more declarations share), chain
# (the functions between two declarations three calls apart). Candidates are
# taken in order of the SHA-256 of "repo|stratum|id".

repo = "protocompile"
commit = "1dbe2800cfc9295ef0a88ff0e6e06face7ecc6b6"

question {
  id = "protocompile-unique-1"
  shape = unique
  text = "In protocompile, which functions and methods call the pendingHasComments method of printer.printer directly?"
  want = ["printBody", "printFile"]
  note = "go://github.com/trendvidia/protocompile/ast/printer#printer.pendingHasComments. 1 declarations in the calls are named pendingHasComments. The type checker's static callers: go://github.com/trendvidia/protocompile/ast/printer#printer.printBody, go://github.com/trendvidia/protocompile/ast/printer#printer.printFile."
}

