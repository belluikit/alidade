question {
  id = "protocompile-chain-1"
  shape = chain
  text = "In protocompile, how does ir.validateFeatures end up calling ir.Type.IsMessage? Name each function or method in the chain between them."
  want = ["AsMessage"]
  note = "go://github.com/trendvidia/protocompile/ir#validateFeatures -> go://github.com/trendvidia/protocompile/ir#Value.AsMessage -> go://github.com/trendvidia/protocompile/ir#Element.AsMessage -> go://github.com/trendvidia/protocompile/ir#Type.IsMessage, the one shortest chain of static calls by the type checker."
}

