question {
  id = "caliper-chain-1"
  shape = chain
  text = "In caliper, how does transform.Rewriter.transformFile end up calling patterns.typeMatches? Name each function or method in the chain between them."
  want = ["MatchNode", "enforceTypeConstraints"]
  note = "go://github.com/trendvidia/caliper/pkg/transform#Rewriter.transformFile -> go://github.com/trendvidia/caliper/pkg/analysis/patterns#Pattern.MatchNode -> go://github.com/trendvidia/caliper/pkg/analysis/patterns#Pattern.enforceTypeConstraints -> go://github.com/trendvidia/caliper/pkg/analysis/patterns#typeMatches, the one shortest chain of static calls by the type checker."
}

