# Questions over caliper drawn by rule, not picked (#284): bench.Generate over the
# type checker's static calls (internal/oracle), without tests, at the commit
# below. Strata: unique (callers of a name no other declaration shares),
# shared (callers of a method name five or more declarations share), chain
# (the functions between two declarations three calls apart). Candidates are
# taken in order of the SHA-256 of "repo|stratum|id".

repo = "caliper"
commit = "b5619f651fb7cfec7b7c514a47382c9ca0a60888"

question {
  id = "caliper-unique-1"
  shape = unique
  text = "In caliper, which functions and methods call the function mcp.transformResultWithDiff directly?"
  want = ["handleAddMissingCleanup", "handleApplyTransform", "handleMigrateAPI"]
  note = "go://github.com/trendvidia/caliper/pkg/mcp#transformResultWithDiff. 1 declarations in the calls are named transformResultWithDiff. The type checker's static callers: go://github.com/trendvidia/caliper/pkg/mcp#Server.handleAddMissingCleanup, go://github.com/trendvidia/caliper/pkg/mcp#Server.handleApplyTransform, go://github.com/trendvidia/caliper/pkg/mcp#Server.handleMigrateAPI."
}

